{
  "name": "simple-crud-application",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "deploy": "ng deploy",
    "deployOnGithub": "ng deploy --base-href=/Simple-CRUD-Application/",
    "start": "ng serve",
    "build": "ng build",
    "docker:build": "npm install && ng build && docker build -t frontend .",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test-coverage": "ng test --code-coverage --no-watch --no-progress --browsers=ChromeHeadless",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.9",
    "@angular/common": "21.2.9",
    "@angular/compiler": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/forms": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/platform-browser-dynamic": "21.2.9",
    "@angular/router": "21.2.9",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.7",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.9",
    "@types/bootstrap": "5.2.11",
    "@types/jasmine": "6.0.0",
    "@types/node": "24.12.2",
    "angular-eslint": "21.3.1",
    "codecov": "3.8.3",
    "eslint": "10.2.1",
    "jasmine-core": "5.13.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.2"
  }
}
