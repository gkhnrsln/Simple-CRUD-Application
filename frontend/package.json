{
  "name": "simple-crud-application",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "deploy": "ng deploy",
    "deployOnGithub": "ng deploy --base-href=/Simple-CRUD-Application/",
    "start": "ng serve",
    "build": "ng build",
    "docker:build": "npm install && ng build && docker build -t frontend .",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test-coverage": "ng test --code-coverage --no-watch --no-progress --browsers=ChromeHeadless",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.2.4",
    "@angular/common": "20.2.4",
    "@angular/compiler": "20.2.4",
    "@angular/core": "20.2.4",
    "@angular/forms": "20.2.4",
    "@angular/platform-browser": "20.2.4",
    "@angular/platform-browser-dynamic": "20.2.4",
    "@angular/router": "20.2.4",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.2",
    "@angular/cli": "20.3.2",
    "@angular/compiler-cli": "20.2.4",
    "@types/bootstrap": "5.2.10",
    "@types/jasmine": "5.1.9",
    "@types/node": "22.18.3",
    "angular-eslint": "20.3.0",
    "codecov": "3.8.3",
    "eslint": "9.35.0",
    "jasmine-core": "5.10.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.42.0"
  }
}
